# --------------------------------------------------------------------------- #
#  NOXbot Shop — environment configuration
#  Copy this file to `.env` and fill in the real values.
# --------------------------------------------------------------------------- #

# --- Telegram (required) ---
# Bot token issued by @BotFather.
BOT_TOKEN=8726649647:AAHRLGXUbnFUMd5ktNaNQfZrRmYMySqayak
# Numeric Telegram user id of the main admin (owner).
OWNER_ID=6929510084
# Additional owner/admin IDs, separated by commas.
OWNER_IDS=
# Temporary admin login password.
ADMIN_PASSWORD=mamad

# --- Database --------------------------------------------------------------- #
# Use an ABSOLUTE path so the database lives in one fixed place no matter which
# folder the bot is launched from. A relative path ("noxbot.db") would create a
# fresh empty database in each launch directory — making data look like it is
# deleted on every restart.
#
# IMPORTANT: If you leave DATABASE_URL commented out or unset, the default will be:
#   <project_root>/noxbot.db
# which is the recommended configuration for most users.
#
# PostgreSQL example: postgresql+asyncpg://user:pass@localhost/noxbot
# SQLite custom path example (Windows): sqlite+aiosqlite:///C:/path/to/noxbot.db
# SQLite custom path example (Linux): sqlite+aiosqlite:////absolute/path/to/noxbot.db
#
# DATABASE_URL=sqlite+aiosqlite:///path/to/your/noxbot.db

# --- Runtime ---------------------------------------------------------------- #
DEFAULT_LANGUAGE=fa
LOG_LEVEL=INFO

# --- Payment (editable from the Admin Panel later) --------------------------- #
CARD_NUMBER=22234444
CARD_HOLDER=5455455
BANK_NAME=m

# --- Support / Welcome (editable from the Admin Panel later) ----------------- #
SUPPORT_TEXT=برای پشتیبانی با ادمین تماس بگیرید.
WELCOME_MESSAGE=به فروشگاه گیمینگ NOXbot خوش آمدید!
